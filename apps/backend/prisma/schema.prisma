generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model employees {
  id                               String        @id @default(uuid()) @db.Uuid
  name                             String        @db.VarChar(100)
  role                             employee_role
  city                             String        @db.VarChar(100)
  country                          String        @db.VarChar(100)
  availability                     Boolean
  createdAt                        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  jobs_jobs_editor_idToemployees   jobs[]        @relation("jobs_editor_idToemployees")
  jobs_jobs_reporter_idToemployees jobs[]        @relation("jobs_reporter_idToemployees")

  @@index([role, availability, city], map: "idx_employee_assignment")
}

model jobs {
  id                                    String     @id @default(uuid()) @db.Uuid
  caseName                              String     @map("case_name") @db.VarChar(500)
  type                                  job_type
  duration                              Int
  status                                job_status
  city                                  String?    @db.VarChar(100)
  country                               String?    @db.VarChar(100)
  reporterId                            String?    @map("reporter_id") @db.Uuid
  reporterFee                           Int?       @map("reporter_fee")
  editorId                              String?    @map("editor_id") @db.Uuid
  editorFee                             Int?       @map("editor_fee")
  createdAt                             DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                             DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees_jobs_editor_idToemployees   employees? @relation("jobs_editor_idToemployees", fields: [editorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees_jobs_reporter_idToemployees employees? @relation("jobs_reporter_idToemployees", fields: [reporterId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([editorId], map: "idx_jobs_editor_id")
  @@index([reporterId], map: "idx_jobs_reporter_id")
  @@index([status], map: "idx_jobs_status")
}

enum employee_role {
  REPORTER
  EDITOR
}

enum job_status {
  NEW
  ASSIGNED
  TRANSCRIBED
  REVIEWED
  COMPLETED
}

enum job_type {
  PHYSICAL
  REMOTE
}
